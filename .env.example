# SafeSpot Web 配置（复制为 .env 后按需修改；当前进程用 export 注入即可）

# 监听
HOST=127.0.0.1
PORT=3000

# production 时托管 client/dist，并拒绝默认口令
NODE_ENV=development

# 会话签名（生产必改）
SESSION_SECRET=please-change-me

# 开发口令（生产勿用默认 safeeye）
ADMIN_PIN=safeeye

# 仅应急：允许生产带着默认口令启动
# ALLOW_INSECURE=1

# 即使不是 production 也托管前端
# SERVE_CLIENT=1
